rules_version = '2';

// قواعد الحماية: كل مستخدم يرى ما يخصّه فقط.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function isTeacher() { return signedIn() && userData().role == 'teacher'; }
    function isParentOf(studentId) {
      return signedIn() && uid() in
        get(/databases/$(database)/documents/users/$(studentId)).data.parentIds;
    }

    function isAutoGradedQuiz(submissionId) {
      let s = request.resource.data;
      let a = get(/databases/$(database)/documents/assignments/$(s.assignmentId)).data;
      return s.studentId == uid() &&
        submissionId == s.assignmentId + '_' + uid() &&
        s.status == 'graded' && s.gradedBy == 'auto' &&
        a.type == 'quiz' && a.isPublished == true &&
        s.classId == a.classId && userData().classId == a.classId &&
        s.maxScore == a.maxScore &&
        s.score is number && s.score >= 0 && s.score <= s.maxScore;
    }

    function studentAddsQuizGrade(studentId) {
      let next = request.resource.data;
      let prev = resource == null
        ? {'entries': {}, 'totalScore': 0, 'totalMaxScore': 0}
        : resource.data;
      let key = next.lastAssignmentId;
      let added = next.entries.diff(prev.entries);
      let sub = getAfter(/databases/$(database)/documents/submissions/$(key + '_' + studentId)).data;
      return next.studentId == studentId &&
        next.classId == userData().classId &&
        added.addedKeys() == [key].toSet() &&
        added.changedKeys().size() == 0 &&
        added.removedKeys().size() == 0 &&
        sub.gradedBy == 'auto' &&
        next.entries[key].score == sub.score &&
        next.entries[key].maxScore == sub.maxScore &&
        next.totalScore == prev.totalScore + sub.score &&
        next.totalMaxScore == prev.totalMaxScore + sub.maxScore;
    }

    // ===== المستخدمون =====
    match /users/{userId} {
      allow read: if signedIn() &&
        (uid() == userId || isTeacher() || uid() in resource.data.get('parentIds', []));

      // الطالب ووليّ الأمر يسجّلان بنفسيهما. المعلّم يحتاج custom claim من الإدارة.
      allow create: if signedIn() && uid() == userId &&
        (request.resource.data.role in ['student', 'parent'] ||
         (request.resource.data.role == 'teacher' && request.auth.token.teacher == true)) &&
        request.resource.data.get('totalPoints', 0) == 0;

      // المستخدم يعدّل حقولاً محدودة فقط (لا يغيّر دوره أو نقاطه).
      allow update: if signedIn() && uid() == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullName', 'avatarUrl', 'avatarCharacter', 'fcmTokens']);

      // المعلّم يحدّث نقاط الطلاب والدروس المكتملة.
      allow update: if isTeacher() && resource.data.role == 'student' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['totalPoints', 'completedLessonIds', 'parentIds']);
    }

    // ===== الشعب =====
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    // ===== الدروس =====
    match /lessons/{lessonId} {
      allow read: if signedIn() && (resource.data.isPublished == true || isTeacher());
      allow write: if isTeacher();
    }

    // ===== الواجبات =====
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (resource.data.isPublished == true || isTeacher());
      allow write: if isTeacher();
    }

    // ===== التسليمات: المعرّف = {assignmentId}_{studentId} =====
    match /submissions/{submissionId} {
      allow read: if signedIn() && (
        resource.data.studentId == uid() || isTeacher() ||
        isParentOf(resource.data.studentId));

      // يسمح للطالب بالتحقق من وجود تسليمه حتى لو لم يُنشأ بعد.
      allow get: if signedIn() && submissionId.matches('.+_' + uid());

      // اختبار مصحَّح آلياً: الطالب ينشئه مرة واحدة فقط (لا تعديل بعدها)،
      // والدرجة بين صفر والدرجة القصوى للواجب نفسه.
      allow create: if signedIn() && isAutoGradedQuiz(submissionId);

      // الطالب يسلّم بدون درجة، والدرجة يضعها المعلّم فقط.
      allow create, update: if signedIn() &&
        request.resource.data.studentId == uid() &&
        submissionId == request.resource.data.assignmentId + '_' + uid() &&
        request.resource.data.status in ['submitted', 'late'] &&
        request.resource.data.get('score', null) == null &&
        (resource == null || resource.data.status != 'graded');

      allow update: if isTeacher();
    }

    // ===== سجل الدرجات: المعرّف = studentId =====
    match /gradebooks/{studentId} {
      allow read: if signedIn() &&
        (uid() == studentId || isTeacher() || isParentOf(studentId));
      allow write: if isTeacher();

      // الطالب يضيف درجة اختبار واحدة جديدة فقط، مطابقة لتسليمه المحفوظ
      // في المعاملة نفسها، ولا يستطيع تعديل أي درجة سابقة.
      allow create, update: if signedIn() && uid() == studentId &&
        studentAddsQuizGrade(studentId);
    }
  }
}
